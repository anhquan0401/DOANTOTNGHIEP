@model WebApplication1.Areas.Admin.Models.NhanVienAdminVM

@{
    ViewData["Title"] = "Thêm nhân viên mới";
}

<style>
    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 10px 10px 0 0 !important;
    }

    .form-control {
        border-radius: 6px;
        height: 45px; /* Tăng chiều cao input cho dễ nhập */
    }

        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .input-group-text {
        background-color: #f8f9fa;
        border-right: none;
    }

    .form-control-icon {
        border-left: none;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        transition: all 0.3s;
    }

        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            color: white;
        }

    /* Custom Switch cho đẹp hơn checkbox thường */
    .custom-switch .custom-control-label::before {
        height: 1.5rem;
        width: 2.75rem;
        border-radius: 2rem;
    }

    .custom-switch .custom-control-label::after {
        width: calc(1.5rem - 4px);
        height: calc(1.5rem - 4px);
        border-radius: 50%;
    }

    .custom-switch .custom-control-input:checked ~ .custom-control-label::after {
        transform: translateX(1.25rem);
    }
</style>

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="font-weight-bold text-dark">Thêm nhân viên mới</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right bg-transparent">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary">Danh sách</a></li>
                    <li class="breadcrumb-item active text-primary">Tạo mới</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-10">

                <form asp-action="Create" method="post">
                    <div class="card shadow-lg border-0 rounded-lg">
                        <div class="card-header card-header-custom py-3">
                            <h5 class="m-0 font-weight-bold"><i class="fas fa-user-plus mr-2"></i>Thông tin nhân viên</h5>
                        </div>

                        <div class="card-body p-4">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="row">
                                <div class="col-md-6 form-group">
                                    <label asp-for="MaNv" class="font-weight-bold text-muted small text-uppercase">Mã Nhân Viên <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-id-card text-primary"></i></span>
                                        </div>
                                        <input asp-for="MaNv" class="form-control form-control-icon" placeholder="Nhập mã nhân viên..." />
                                    </div>
                                    <span asp-validation-for="MaNv" class="text-danger small mt-1"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="HoTen" class="font-weight-bold text-muted small text-uppercase">Họ và Tên <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-user text-primary"></i></span>
                                        </div>
                                        <input asp-for="HoTen" class="form-control form-control-icon" placeholder="Nhập họ tên đầy đủ..." />
                                    </div>
                                    <span asp-validation-for="HoTen" class="text-danger small mt-1"></span>
                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-md-6 form-group">
                                    <label asp-for="Email" class="font-weight-bold text-muted small text-uppercase">Email Liên Hệ <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-envelope text-primary"></i></span>
                                        </div>
                                        <input asp-for="Email" type="email" class="form-control form-control-icon" placeholder="example@gmail.com" />
                                    </div>
                                    <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                                </div>

                                <div class="col-md-6 form-group">
                                    <label asp-for="MatKhau" class="font-weight-bold text-muted small text-uppercase">Mật Khẩu <span class="text-danger">*</span></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-lock text-primary"></i></span>
                                        </div>
                                        <input asp-for="MatKhau" type="password" class="form-control form-control-icon" placeholder="Nhập mật khẩu..." />
                                    </div>
                                    <span asp-validation-for="MatKhau" class="text-danger small mt-1"></span>
                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-md-6 form-group">
                                    <label asp-for="MaPq" class="font-weight-bold text-muted small text-uppercase">Vai Trò</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-user-tag text-primary"></i></span>
                                        </div>
                                        <select asp-for="MaPq" class="form-control form-control-icon">
                                            <option value="2">Nhân viên thường</option>
                                            <option value="1">Quản trị viên (Admin)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6 form-group d-flex align-items-center">
                                    <div class="mt-4 ml-2">
                                        <div class="custom-control custom-switch">
                                            <input type="checkbox" class="custom-control-input" asp-for="XacNhan" id="customSwitch1" checked>
                                            <label class="custom-control-label font-weight-bold text-dark" for="customSwitch1">Kích hoạt tài khoản ngay</label>
                                        </div>
                                        <small class="form-text text-muted mt-1">Nếu tắt, nhân viên sẽ không thể đăng nhập.</small>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="card-footer bg-white d-flex justify-content-between py-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">
                                <i class="fas fa-arrow-left mr-2"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-gradient px-5 rounded-pill font-weight-bold">
                                <i class="fas fa-save mr-2"></i> Lưu Nhân Viên
                            </button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}