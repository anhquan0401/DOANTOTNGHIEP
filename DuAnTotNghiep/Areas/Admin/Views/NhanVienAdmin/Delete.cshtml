@model WebApplication1.Areas.Admin.Models.NhanVienAdminVM

@{
    ViewData["Title"] = "Xóa nhân viên";
}

<style>
    /* Card cảnh báo */
    .delete-card {
        border: none;
        border-top: 5px solid #dc3545; /* Viền đỏ trên cùng */
        box-shadow: 0 10px 25px rgba(220, 53, 69, 0.15);
        border-radius: 8px;
    }

    .delete-header {
        background-color: #fff;
        padding: 30px 20px 10px;
        text-align: center;
    }

    .danger-icon-circle {
        width: 80px;
        height: 80px;
        background-color: #fce8e6; /* Màu đỏ rất nhạt */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        animation: pulse-red 2s infinite;
    }

        .danger-icon-circle i {
            font-size: 3rem;
            color: #dc3545;
        }

    .user-info-box {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
        border-left: 4px solid #adb5bd;
    }

    .info-label {
        font-weight: 600;
        color: #6c757d;
        font-size: 0.9rem;
        text-transform: uppercase;
    }

    .info-value {
        font-weight: 700;
        color: #343a40;
        font-size: 1.1rem;
    }

    /* Hiệu ứng nhịp đập cảnh báo */
    @@keyframes pulse-red {
        0% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.4);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(220, 53, 69, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(220, 53, 69, 0);
        }
    }
</style>

<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Xóa nhân viên</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right bg-transparent p-0">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-muted">Danh sách</a></li>
                    <li class="breadcrumb-item active text-danger">Xóa</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="card delete-card">
                    <div class="delete-header">
                        <div class="danger-icon-circle">
                            <i class="fas fa-trash-alt"></i>
                        </div>
                        <h3 class="font-weight-bold text-danger">Bạn có chắc chắn muốn xóa?</h3>
                        <p class="text-muted">
                            Hành động này <span class="font-weight-bold text-dark">không thể hoàn tác</span>.
                            Toàn bộ dữ liệu liên quan đến nhân viên này sẽ bị ảnh hưởng.
                        </p>
                    </div>

                    <div class="card-body px-4">
                        <div class="user-info-box">
                            <div class="row mb-3">
                                <div class="col-12 text-center mb-3">
                                    <img class="img-circle border" style="width: 80px; height: 80px;"
                                         src="https://ui-avatars.com/api/?name=@Model.HoTen&background=random&size=128"
                                         alt="Avatar">
                                </div>
                            </div>

                            <div class="row mb-2 border-bottom pb-2">
                                <div class="col-4 info-label">Họ và tên</div>
                                <div class="col-8 info-value">@Model.HoTen</div>
                            </div>

                            <div class="row mb-2 border-bottom pb-2">
                                <div class="col-4 info-label">Mã NV</div>
                                <div class="col-8 info-value text-primary">@Model.MaNv</div>
                            </div>

                            <div class="row mb-2 border-bottom pb-2">
                                <div class="col-4 info-label">Email</div>
                                <div class="col-8 info-value">@Model.Email</div>
                            </div>

                            <div class="row">
                                <div class="col-4 info-label">Vai trò</div>
                                <div class="col-8 info-value">
                                    @if (Model.MaPq == 1)
                                    {
                                        <span>Quản trị viên</span>
                                    }
                                    else
                                    {

                                        <span>Nhân viên</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <form asp-action="Delete">
                            <input type="hidden" asp-for="MaNv" />

                            <div class="d-flex justify-content-between mt-4 mb-2">
                                <a asp-action="Index" class="btn btn-light border px-4 rounded-pill font-weight-bold">
                                    <i class="fas fa-times mr-2"></i> Hủy bỏ
                                </a>
                                <button type="submit" class="btn btn-danger px-4 rounded-pill font-weight-bold shadow-sm">
                                    <i class="fas fa-trash mr-2"></i> Xác nhận xóa
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>