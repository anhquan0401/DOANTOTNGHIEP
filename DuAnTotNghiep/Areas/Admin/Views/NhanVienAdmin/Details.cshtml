@model WebApplication1.Areas.Admin.Models.NhanVienAdminVM

@{
    ViewData["Title"] = "Hồ sơ nhân viên";
}

<style>
    /* --- Global Styles --- */
    body {
        background-color: #f4f6f9; /* Nền xám nhạt cho toàn trang */
    }

    /* --- Profile Left Card --- */
    .profile-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        overflow: hidden;
    }

    .profile-cover {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        height: 160px;
        position: relative;
    }

        /* Pattern phủ lên cover để tạo texture đẹp mắt */
        .profile-cover::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.1' fill-rule='evenodd'%3E%3Ccircle cx='3' cy='3' r='3'/%3E%3Ccircle cx='13' cy='13' r='3'/%3E%3C/g%3E%3C/svg%3E");
        }

    .profile-user-img {
        border: 4px solid #fff;
        margin-top: -80px;
        width: 140px;
        height: 140px;
        object-fit: cover;
        box-shadow: 0 5px 10px rgba(0,0,0,0.1);
        position: relative;
        z-index: 1;
        background: #fff; /* Tránh trong suốt khi load ảnh */
    }

    /* --- Details Right Card --- */
    .details-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        border-top: 4px solid #667eea; /* Viền màu đồng bộ */
    }

    .section-title {
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 1px;
        color: #adb5bd;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }

        .section-title::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #e9ecef;
            margin-left: 10px;
        }

    .detail-row {
        padding: 16px 12px;
        border-radius: 8px;
        transition: all 0.2s ease-in-out;
        border-bottom: 1px solid #f8f9fa;
    }

        .detail-row:hover {
            background-color: #f8faff; /* Màu nền khi hover */
            transform: translateX(5px); /* Hiệu ứng di chuyển nhẹ */
        }

    .info-label {
        color: #6c757d;
        font-weight: 500;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

        .info-label i {
            width: 24px;
            text-align: center;
            margin-right: 10px;
            font-size: 1.1rem;
        }

    .info-value {
        color: #2d3436;
        font-weight: 600;
        font-size: 1rem;
    }
</style>

<section class="content-header pt-3 pb-3">
    <div class="container-fluid">
        <div class="row mb-2 align-items-center">
            <div class="col-sm-6">
                <h1 class="m-0 text-dark" style="font-weight: 700;">Hồ sơ nhân viên</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right bg-transparent p-0 m-0">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-secondary">Danh sách</a></li>
                    <li class="breadcrumb-item active text-primary">Chi tiết</li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="content pb-4">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-4 mb-4">
                <div class="card profile-card">
                    <div class="profile-cover"></div>

                    <div class="card-body text-center pt-0">
                        <img class="profile-user-img img-fluid img-circle rounded-circle"
                             src="https://ui-avatars.com/api/?name=@Model.HoTen&background=random&size=256&bold=true&color=fff"
                             alt="User profile picture">

                        <h3 class="font-weight-bold mt-3 mb-1">@Model.HoTen</h3>

                        <div class="mb-4">
                            @if (Model.MaPq == 0)
                            {
                                <span class="badge badge-pill badge-danger px-3 py-2 shadow-sm">
                                    <i class="fas fa-crown mr-1"></i> Quản Trị Viên
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-pill badge-info px-3 py-2 shadow-sm">
                                    <i class="fas fa-user-tie mr-1"></i> Nhân Viên
                                </span>
                            }
                        </div>

                        <div class="row text-center border-top pt-3 mt-3">
                            <div class="col-6 border-right">
                                <span class="d-block text-muted small text-uppercase">Mã NV</span>
                                <span class="h5 font-weight-bold text-primary">@Model.MaNv</span>
                            </div>
                            <div class="col-6">
                                <span class="d-block text-muted small text-uppercase">Trạng Thái</span>
                                @if (Model.XacNhan)
                                {
                                    <span class="text-success font-weight-bold"><i class="fas fa-check-circle"></i> Active</span>
                                }
                                else
                                {
                                    <span class="text-warning font-weight-bold"><i class="fas fa-hourglass-half"></i> Pending</span>
                                }
                            </div>
                        </div>

                        <div class="mt-4">
                            <a asp-action="Edit" asp-route-id="@Model.MaNv" class="btn btn-primary btn-block rounded-pill shadow-sm transition-hover">
                                <i class="fas fa-pen mr-2"></i> Chỉnh sửa thông tin
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card details-card">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                        <h4 class="card-title font-weight-bold text-dark">
                            <i class="fas fa-info-circle text-primary mr-2"></i>Chi tiết hồ sơ
                        </h4>
                    </div>

                    <div class="card-body">

                        <div class="section-title">THÔNG TIN ĐỊNH DANH</div>

                        <div class="row detail-row">
                            <div class="col-sm-4 info-label">
                                <i class="fas fa-user text-primary"></i> Họ và tên
                            </div>
                            <div class="col-sm-8 info-value">
                                @Model.HoTen
                            </div>
                        </div>

                        <div class="row detail-row">
                            <div class="col-sm-4 info-label">
                                <i class="fas fa-id-card text-success"></i> Mã nhân viên
                            </div>
                            <div class="col-sm-8 info-value font-monospace text-secondary">
                                @Model.MaNv
                            </div>
                        </div>

                        <div class="section-title mt-4">TÀI KHOẢN & BẢO MẬT</div>

                        <div class="row detail-row">
                            <div class="col-sm-4 info-label">
                                <i class="fas fa-envelope text-warning"></i> Email
                            </div>
                            <div class="col-sm-8 info-value">
                                <a href="mailto:@Model.Email" class="text-decoration-none font-weight-bold">@Model.Email</a>
                            </div>
                        </div>

                        <div class="row detail-row">
                            <div class="col-sm-4 info-label">
                                <i class="fas fa-shield-alt text-danger"></i> Quyền hạn
                            </div>
                            <div class="col-sm-8 info-value">
                                @if (Model.MaPq == 1)
                                {
                                    <span>Toàn quyền hệ thống (Full Access)</span>
                                }
                                else
                                {
                                    <span>Quyền hạn chế (Limited Access)</span>
                                }
                            </div>
                        </div>

                        <div class="row detail-row border-bottom-0">
                            <div class="col-sm-4 info-label">
                                <i class="fas fa-lock text-dark"></i> Mật khẩu
                            </div>
                            <div class="col-sm-8 info-value text-muted">
                                •••••••••••• <small class="ml-2 font-italic">(Đã mã hóa)</small>
                            </div>
                        </div>

                    </div>

                    <div class="card-footer bg-white border-top-0 pb-4 pt-0">
                        <hr class="mt-0 mb-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left mr-2"></i> Quay lại danh sách
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>