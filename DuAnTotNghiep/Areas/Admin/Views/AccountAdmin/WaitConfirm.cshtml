@{
    // Thiết lập tiêu đề trang
    ViewData["Title"] = "Chờ xét duyệt";
    // Thêm Layout nếu cần
    // Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* CSS Tùy chỉnh cho thông báo */
    .pending-page {
        min-height: 70vh; /* Đảm bảo trang có đủ chiều cao */
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: #f8f9fa; /* Màu nền nhẹ nhàng */
    }

    .pending-card {
        max-width: 600px;
        text-align: center;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        background-color: #fff;
        border-top: 5px solid #ffc107; /* Viền vàng nổi bật */
    }

    .pending-icon {
        color: #ffc107; /* Màu vàng cảnh báo */
        font-size: 5rem;
        margin-bottom: 20px;
        animation: pulse 1.5s infinite; /* Tạo hiệu ứng nhấp nháy nhẹ */
    }

    /* Hiệu ứng nhấp nháy */
    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.05);
            opacity: 0.8;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<div class="pending-page">
    <div class="pending-card">

        <div class="pending-icon">
            <i class="fa fa-clock-o"></i>
        </div>

        <h1 class="text-warning mb-3">
            Thông báo: **Tài khoản đang chờ xét duyệt**
        </h1>

        <p class="lead text-muted">
            Tài khoản của quý khách đã được tạo thành công nhưng hiện đang **chờ quản trị viên kích hoạt**.
        </p>

        <p class="text-secondary">
            Quá trình này thường mất từ **vài phút đến 24 giờ**. Chúng tôi sẽ thông báo cho quý khách qua email ngay khi tài khoản được kích hoạt.
        </p>

        <hr class="my-4">

        <a asp-area="Admin" asp-controller="AccountAdmin" asp-action="LoginAdmin" class="btn btn-warning btn-lg">
            <i class="fa fa-home"></i> Quay lại Trang chủ
        </a>
        <a href="mailto:support@yourcompany.com" class="btn btn-outline-secondary btn-lg ml-3">
            <i class="fa fa-envelope"></i> Liên hệ Hỗ trợ
        </a>

    </div>
</div>