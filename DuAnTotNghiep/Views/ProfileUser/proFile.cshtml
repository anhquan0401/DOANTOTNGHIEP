@model WebApplication1.ViewModels.ProFileVM
@{
    ViewData["Title"] = "Thông Tin Cá Nhân";
    // Định dạng ngày sinh (nếu cần)
    var birthDateFormatted = Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật";
}

<style>
    /* 1. Variables & Base Styles */
    :root {
        --primary-color: #007bff; /* Blue */
        --primary-hover: #0056b3;
        --border-color: #e2e8f0;
        --bg-light: #f8fafc;
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --shadow-soft: 0 4px 15px rgba(0, 0, 0, 0.07);
        --shadow-lifted: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .profile-page-container {
        background-color: var(--bg-light);
        padding-bottom: 4rem; /* Thêm padding dưới */
    }

    .profile-container {
        max-width: 900px; /* Giới hạn độ rộng */
        margin: 3rem auto;
        animation: fadeInUp 0.8s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* 2. Profile Card */
    .profile-card {
        background: #ffffff;
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        box-shadow: var(--shadow-soft);
        overflow: hidden;
        transition: all 0.3s ease-out;
    }

        .profile-card:hover {
            box-shadow: var(--shadow-lifted);
        }

    .profile-card-header {
        background: var(--bg-light);
        padding: 1.5rem 2rem;
        border-bottom: 1px solid var(--border-color);
    }

        .profile-card-header h3 {
            margin: 0;
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--text-dark);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .profile-card-header i {
            color: var(--primary-color);
        }

    /* 3. Bố cục 2 cột trong Card Body */
    .profile-card-body {
        padding: 2.5rem;
        display: grid;
        grid-template-columns: 1fr; /* Mặc định 1 cột */
        gap: 2.5rem; /* Khoảng cách giữa avatar và info */
    }

    /* 4. Cột Avatar (Trái) */
    .profile-avatar-section {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .avatar-img {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        object-fit: cover;
        border: 5px solid white;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        margin-bottom: 1rem;
    }

    .btn-change-avatar {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--primary-color);
        background: #eef2ff;
        border: 1px dashed var(--primary-color);
        padding: 0.5rem 1rem;
        border-radius: 2rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-change-avatar:hover {
            background: var(--primary-color);
            color: white;
        }


    /* 5. Cột Thông tin (Phải) */
    .profile-info-section {
        /* Không cần style đặc biệt nếu dùng list */
    }

    /* 6. Danh sách thông tin */
    .info-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .info-item {
        display: flex;
        align-items: flex-start; /* Canh lề trên nếu text dài */
        padding: 1rem 0;
        border-bottom: 1px solid var(--border-color);
    }

        .info-item:last-child {
            border-bottom: none;
        }

    .info-icon {
        color: var(--primary-color);
        font-size: 1.3rem;
        width: 30px; /* Đảm bảo icon thẳng hàng */
        margin-right: 1.25rem;
        margin-top: 2px; /* Chỉnh nhẹ vị trí icon */
    }

    .info-content {
        flex: 1;
    }

    .info-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: block;
        margin-bottom: 0.25rem;
    }

    .info-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-dark);
        word-break: break-word; /* Chống tràn nếu text quá dài */
    }

    /* 7. Nút Edit Profile */
    .profile-actions {
        margin-top: 2rem;
        text-align: center; /* Căn giữa nút */
    }

    .btn-edit-profile {
        background: var(--primary-color);
        color: white;
        border: none;
        padding: 0.75rem 2rem;
        font-weight: 700;
        border-radius: 0.5rem;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex; /* Cho icon vào cùng hàng */
        align-items: center;
        gap: 0.5rem;
    }

        .btn-edit-profile:hover {
            background: var(--primary-hover);
            box-shadow: 0 4px 10px rgba(0, 123, 255, 0.3);
            transform: translateY(-2px);
        }

    /* Responsive */
    @@media (min-width: 768px) {
        .profile-card-body {
            grid-template-columns: 200px 1fr; /* Chia 2 cột trên màn hình lớn hơn */
        }

        .profile-avatar-section {
            align-items: center; /* Đã là center */
        }

        .profile-actions {
            text-align: right; /* Căn phải nút trên desktop */
            margin-top: 0; /* Bỏ margin top vì nút nằm trong card */
            padding: 0 2.5rem 2.5rem; /* Thêm padding cho nút */
        }

        .profile-card-footer { /* Optional: Footer for button */
            padding: 1.5rem 2.5rem;
            background: var(--bg-light);
            border-top: 1px solid var(--border-color);
            text-align: right;
        }
    }

</style>

<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Hồ sơ cá nhân</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="#">Tài khoản</a></li>
        <li class="breadcrumb-item active text-white">Hồ sơ</li>
    </ol>
</div>
<div class="profile-page-container">
    <div class="profile-container">
        <div class="profile-card">
            <div class="profile-card-header">
                <h3><i class="bi bi-person-badge-fill"></i> Thông Tin Cá Nhân</h3>
            </div>

            <div class="profile-card-body">
                <div class="profile-avatar-section">
                    <img src="~/Hinh/KhachHang/@Model.FileHinh" class="avatar-img" alt="Ảnh đại diện">
                    @* Nút này chỉ để hiển thị, bạn cần thêm chức năng nếu muốn *@
                    <a href="#" class="btn-change-avatar">
                        <i class="bi bi-camera-fill me-1"></i> Thay đổi ảnh
                    </a>
                </div>

                <div class="profile-info-section">
                    <ul class="info-list">
                        <li class="info-item">
                            <i class="bi bi-at info-icon"></i>
                            <div class="info-content">
                                <span class="info-label">Tên đăng nhập</span>
                                <span class="info-value">@Model.MaKh</span>
                            </div>
                        </li>
                        <li class="info-item">
                            <i class="bi bi-person-fill info-icon"></i>
                            <div class="info-content">
                                <span class="info-label">Họ và tên</span>
                                <span class="info-value">@Model.HoTen</span>
                            </div>
                        </li>
                        <li class="info-item">
                            @if (Model.GioiTinh == true)
                            {
                                <i class="bi bi-gender-male info-icon"></i>
                            }
                            else
                            {
                                <i class="bi bi-gender-female info-icon"></i>
                            }
                            <div class="info-content">
                                <span class="info-label">Giới tính</span>
                                <span class="info-value">@(Model.GioiTinh == true ? "Nam" : "Nữ")</span>
                            </div>
                        </li>
                        <li class="info-item">
                            <i class="bi bi-calendar-heart info-icon"></i>
                            <div class="info-content">
                                <span class="info-label">Ngày sinh</span>
                                <span class="info-value">@birthDateFormatted</span>
                            </div>
                        </li>
                        <li class="info-item">
                            <i class="bi bi-geo-alt-fill info-icon"></i>
                            <div class="info-content">
                                <span class="info-label">Địa chỉ</span>
                                <span class="info-value">@(string.IsNullOrEmpty(Model.DiaChi) ? "Chưa cập nhật" : Model.DiaChi)</span>
                            </div>
                        </li>
                        <li class="info-item">
                            <i class="bi bi-telephone-fill info-icon"></i>
                            <div class="info-content">
                                <span class="info-label">Điện thoại</span>
                                <span class="info-value">@Model.DienThoai</span>
                            </div>
                        </li>
                        <li class="info-item">
                            <i class="bi bi-envelope-fill info-icon"></i>
                            <div class="info-content">
                                <span class="info-label">Email</span>
                                <span class="info-value">@Model.Email</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="profile-card-footer">
                <a asp-action="editFrofile" asp-route-id="@Model.MaKh" class="btn-edit-profile">
                    <i class="bi bi-pencil-square"></i> Chỉnh sửa thông tin
                </a>
            </div>
        </div>
    </div>
</div>