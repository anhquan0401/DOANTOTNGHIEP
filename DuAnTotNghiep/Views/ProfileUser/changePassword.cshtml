@model WebApplication1.ViewModels.ChangePasswordVM
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    /* 1. Variables & Base Styles (Reusing from previous styles) */
    :root {
        --primary-color: #007bff; /* Blue */
        --primary-hover: #0056b3;
        --success-color: #198754; /* Bootstrap Green */
        --success-hover: #157347;
        --secondary-color: #6c757d; /* Gray */
        --border-color: #dee2e6;
        --bg-light: #f8fafc;
        --text-dark: #212529;
        --text-muted: #6c757d;
        --shadow-soft: 0 0.5rem 1rem rgba(0, 0, 0, 0.1);
        --shadow-lifted: 0 1rem 3rem rgba(0, 0, 0, 0.15); /* Slightly stronger shadow */
    }

    .change-password-wrapper {
        background-color: var(--bg-light);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem;
        min-height: 70vh;
    }

    /* 2. Centered Card */
    .change-password-card {
        background: #ffffff;
        border-radius: 1rem;
        box-shadow: var(--shadow-soft);
        padding: 2.5rem 3rem; /* More padding */
        max-width: 550px; /* Optimal width */
        width: 100%;
        text-align: center;
        transition: all 0.3s ease-out;
        animation: fadeInUp 0.6s ease-out;
    }

        .change-password-card:hover {
            box-shadow: var(--shadow-lifted);
        }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* 3. Card Content */
    .card-icon {
        font-size: 3rem;
        color: var(--primary-color);
        margin-bottom: 1rem;
    }

    .card-title {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 1.75rem; /* Slightly smaller than forgot password */
        margin-bottom: 0.75rem;
    }

    .card-description {
        font-size: 1rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
    }

    /* 4. Form Styling */
    .form-group {
        margin-bottom: 1.5rem;
        text-align: left; /* Align labels left */
    }

    .form-label {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border: 2px solid var(--border-color);
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(0,123,255,0.15);
            outline: none;
        }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
        display: block; /* Ensure it takes space */
    }
    /* Validation summary */
    .validation-summary-errors {
        background: #fff1f2;
        color: #ef4444;
        border: 1px solid #ffe4e6;
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1.5rem;
        text-align: left;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 1rem;
        }

    /* 5. Button Styling */
    .form-actions {
        margin-top: 2rem;
        display: flex;
        flex-direction: column; /* Stack buttons vertically */
        gap: 0.75rem;
    }

    /* .btn {
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center; /* Center text in button */
        gap: 0.5rem;
        width: 100%; /* Make buttons full width */
    } */

    .btn-save {
        background-color: var(--success-color);
        border-color: var(--success-color);
        color: white;
    }

        .btn-save:hover {
            background-color: var(--success-hover);
            border-color: var(--success-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(25, 135, 84, 0.3);
        }

    .btn-cancel { /* Link styled as button */
        color: var(--secondary-color);
        font-weight: 500;
        text-decoration: none;
        margin-top: 0.5rem; /* Add some space above cancel */
    }

        .btn-cancel:hover {
            color: var(--text-dark);
            text-decoration: underline;
        }

</style>

<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Đổi mật khẩu</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="ProFile">Hồ sơ</a></li>
        <li class="breadcrumb-item active text-white">Đổi mật khẩu</li>
    </ol>
</div>
<div class="change-password-wrapper">
    <div class="change-password-card">
        <div class="card-icon"><i class="bi bi-lock-fill"></i></div>
        <h3 class="card-title">Thay Đổi Mật Khẩu</h3>
        <p class="card-description">
            Nhập mật khẩu hiện tại và mật khẩu mới của bạn.
        </p>

        <form asp-action="changePassword" asp-controller="ProfileUser">
            <div asp-validation-summary="All" class="text-danger validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="oldMatKhau" class="form-label">Mật khẩu hiện tại <sup>*</sup></label>
                <input asp-for="oldMatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại...">
                <span asp-validation-for="oldMatKhau" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="newMatKhau" class="form-label">Mật khẩu mới <sup>*</sup></label>
                <input asp-for="newMatKhau" type="password" class="form-control" placeholder="Nhập mật khẩu mới...">
                <span asp-validation-for="newMatKhau" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="renewMatKhau" class="form-label">Xác nhận mật khẩu mới <sup>*</sup></label>
                <input asp-for="renewMatKhau" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới...">
                <span asp-validation-for="renewMatKhau" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-save">
                    <i class="bi bi-check-circle-fill"></i> Lưu thay đổi
                </button>
                <a asp-action="ProFile" class="btn-cancel">Hủy</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}