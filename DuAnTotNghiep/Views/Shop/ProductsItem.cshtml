@model IEnumerable<WebApplication1.ViewModels.HangHoaVM>
@{
    var countSold = ViewBag.Sold;
}

@foreach (var item in Model)
{
    <div class="col-md-6 col-lg-4 mb-4">
        <div class="product-card h-100">

            <div class="product-img-wrapper">
                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.MaHH">
                    <img src="~/Hinh/HangHoa/@item.Img" style="width: 271px !important; height: 287px !important;" class="product-img" alt="@item.TenHH">
                </a>

                @if (item.DaBan > 0)
                {
                    <div class="badge-sold">
                        <i class="fa fa-fire text-warning me-1"></i> Đã bán @item.DaBan
                    </div>
                }
            </div>

            <div class="product-body">
                <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.MaHH" class="text-decoration-none">
                    <h5 class="product-title" title="@item.TenHH">@item.TenHH</h5>
                </a>

                <div class="d-flex justify-content-between align-items-end mb-3">
                    <div class="product-price">
                        @string.Format("{0:N0} ₫", item.DonGia)
                    </div>
                    <div class="product-stock text-muted">
                        <small>Kho: <span class="fw-bold text-dark">@item.Soluong</span></small>
                    </div>
                </div>

                <a asp-action="AddToCart" asp-controller="Cart" asp-route-id="@item.MaHH"
                   class="btn-add-cart">
                    <span class="icon-cart"><i class="fa fa-shopping-bag"></i></span>
                    <span class="text-cart">Thêm vào giỏ</span>
                </a>
            </div>
        </div>
    </div>
}

<style>
    /* --- 1. Khung thẻ sản phẩm --- */
    .product-card {
        background: #fff;
        border-radius: 15px;
        border: 1px solid #e0e0e0; /* Viền rõ hơn 1 chút cho sắc nét */
        overflow: hidden;
        transition: all 0.4s ease;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
        height: 100%; /* Đảm bảo thẻ luôn cao hết cỡ */
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-color: transparent;
        }

    /* --- 2. Xử lý hình ảnh (QUAN TRỌNG) --- */
    .product-img-wrapper {
        position: relative;
        overflow: hidden;
        height: 250px; /* Chiều cao cố định */
        width: 100%;
        background-color: #f8f9fa; /* Màu nền lót phòng khi ảnh chưa load */
    }

        /* Bắt buộc thẻ a phải to bằng thẻ div cha */
        .product-img-wrapper a {
            display: block;
            width: 100%;
            height: 100%;
        }

    .product-img {
        width: 100%;
        height: 100%;
        /* 'cover': Ảnh sẽ phóng to để lấp đầy toàn bộ khung (có thể bị cắt nhẹ các cạnh) -> ĐẸP NHẤT */
        /* 'contain': Ảnh sẽ thu nhỏ để hiển thị đầy đủ (có thể lộ khoảng trắng thừa) */
        object-fit: cover;
        object-position: center; /* Luôn lấy trọng tâm ảnh giữa */
        transition: transform 0.6s ease;
    }

    /* Zoom ảnh khi hover */
    .product-card:hover .product-img {
        transform: scale(1.1);
    }

    /* Badge Đã bán */
    .badge-sold {
        position: absolute;
        top: 10px;
        left: 10px;
        background: rgba(255, 255, 255, 0.95);
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 0.75rem;
        font-weight: 700;
        color: #333;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        z-index: 2;
        pointer-events: none; /* Để chuột xuyên qua bấm vào ảnh được */
    }

    /* --- 3. Phần nội dung --- */
    .product-body {
        padding: 20px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .product-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.8rem; /* Cố định chiều cao dòng tên để khung không bị nhảy */
        line-height: 1.4rem;
    }

    .product-card:hover .product-title {
        color: #0d6efd;
    }

    /* Giá tiền to và đậm */
    .product-price {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0d6efd;
    }

    /* --- 4. Nút bấm --- */
    .btn-add-cart {
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #fff;
        color: #333;
        padding: 12px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        border: 2px solid #f0f0f0; /* Viền nút dày hơn chút */
        margin-top: 15px;
    }

        .btn-add-cart i {
            margin-right: 8px;
        }

        .btn-add-cart:hover {
            background-color: #0d6efd;
            color: white;
            border-color: #0d6efd;
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        }

            .btn-add-cart:hover .fa-shopping-bag {
                animation: cart-shake 0.5s ease-in-out;
            }

</style>