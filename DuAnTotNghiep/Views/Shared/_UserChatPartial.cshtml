@if (User.Identity.IsAuthenticated)
{
    <!-- Chat Button -->
    <button id="openChatBtn" class="btn">
        <i class="fas fa-comment"></i>
    </button>

    <!-- Chat Box -->
    <div id="userChatBox" class="card" style="display:none;">
        <!-- Header -->
        <div class="chat-header">
            <div class="chat-header-title">
                <i class="fas fa-comments"></i>
                <span>Nhắn tin với Nhân viên</span>
            </div>
            <button type="button" id="closeChatBtn">
                <i class="fas fa-times" style="color: white;"></i>
            </button>
        </div>

        <!-- Body -->
        <div class="chat-body">
            <!-- Staff List -->
            <div class="staff-list-container">
                <div class="staff-list-header">
                    👥 Nhân viên
                </div>
                <ul id="staffList">
                    <!-- Staff items will be loaded here -->
                    <!-- Example: -->
                    <li class="staff-item" data-staff-id="NV001">
                        <div class="staff-avatar">
                            <span>NV</span>
                            <div class="staff-status"></div>
                        </div>
                        <div class="staff-name">Nguyễn Văn A</div>
                        <div class="staff-role">Support</div>
                    </li>
                    <li class="staff-item" data-staff-id="NV002">
                        <div class="staff-avatar">
                            <span>LT</span>
                            <div class="staff-status"></div>
                        </div>
                        <div class="staff-name">Lê Thị B</div>
                        <div class="staff-role">Sales</div>
                    </li>
                    <li class="staff-item" data-staff-id="NV003">
                        <div class="staff-avatar">
                            <span>PT</span>
                            <div class="staff-status"></div>
                        </div>
                        <div class="staff-name">Phạm Văn C</div>
                        <div class="staff-role">Manager</div>
                    </li>
                </ul>
            </div>

            <!-- Message Area -->
            <div class="message-container">
                <div id="messageContainer">
                    <div class="empty-chat-state">
                        <i class="fas fa-comments"></i>
                        <p><strong>Chào mừng bạn!</strong><br>Chọn nhân viên bên trái để bắt đầu trò chuyện</p>
                    </div>
                </div>

                <!-- Input -->
                <div class="chat-footer">
                    <div class="input-group">
                        <input type="text" id="messageInput" class="form-control" placeholder="💬 Nhập tin nhắn..." />
                        <button class="btn" id="sendMsgBtn">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        :root {
            --primary-color: #3b82f6;
            --primary-dark: #2563eb;
            --success-color: #10b981;
            --bg-light: #f8fafc;
            --border-color: #e2e8f0;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --online-color: #10b981;
        }

        /* Chat Button */
        #openChatBtn {
            position: fixed !important;
            bottom: 6rem !important;
            right: 1.5rem !important;
            z-index: 9999 !important;
            width: 60px !important;
            height: 60px !important;
            background: linear-gradient(135deg, var(--primary-color), #1d4ed8) !important;
            border: none !important;
            border-radius: 50% !important;
            box-shadow: 0 8px 20px rgba(59, 130, 246, 0.4) !important;
            transition: all 0.3s ease !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer;
        }

            #openChatBtn:hover {
                transform: translateY(-4px) scale(1.1) !important;
                box-shadow: 0 12px 28px rgba(59, 130, 246, 0.5) !important;
            }

            #openChatBtn i {
                font-size: 1.5rem;
                color: white;
            }

            #openChatBtn::before {
                content: '';
                position: absolute;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--primary-color), #1d4ed8);
                animation: pulse-ring 2s infinite;
                z-index: -1;
            }





        /* Chat Box */
        #userChatBox {
            position: fixed !important;
            bottom: 8rem !important;
            right: 4rem !important;
            width: 420px !important;
            height: 580px !important;
            z-index: 9998 !important;
            border-radius: 1rem !important;
            border: none !important;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15) !important;
            overflow: hidden !important;
            animation: slideInUp 0.3s ease !important;
        }


        /* Chat Header */
        .chat-header {
            background: linear-gradient(135deg, var(--primary-color), #1d4ed8) !important;
            color: white !important;
            padding: 1.25rem 1.5rem !important;
            display: flex !important;
            justify-content: space-between !important;
            align-items: center !important;
            border: none !important;
        }

        .chat-header-title {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-weight: 700;
            font-size: 1rem;
        }

            .chat-header-title i {
                font-size: 1.25rem;
            }

        #closeChatBtn {
            background: rgba(255, 255, 255, 0.2) !important;
            border-radius: 50% !important;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s ease;
            border: none;
        }

            #closeChatBtn:hover {
                background: rgba(255, 255, 255, 0.3) !important;
                transform: rotate(90deg);
            }

        /* Chat Body */
        .chat-body {
            display: flex !important;
            height: calc(100% - 64px) !important;
            padding: 0 !important;
        }

        /* Staff List */
        .staff-list-container {
            width: 140px !important;
            background: linear-gradient(135deg, var(--bg-light), #e2e8f0) !important;
            border-right: 2px solid var(--border-color) !important;
            overflow-y: auto !important;
            padding: 0.5rem !important;
        }

        .staff-list-header {
            padding: 0.75rem 0.5rem;
            font-weight: 700;
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        #staffList {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .staff-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 0.875rem 0.5rem;
            margin-bottom: 0.5rem;
            background: white;
            border-radius: 0.75rem;
            cursor: pointer;
            transition: all 0.2s ease;
            border: 2px solid transparent;
            position: relative;
        }

            .staff-item:hover {
                background: linear-gradient(135deg, #dbeafe, #bfdbfe);
                transform: translateX(4px);
                border-color: var(--primary-color);
            }

            .staff-item.active {
                background: linear-gradient(135deg, var(--primary-color), #1d4ed8);
                color: white;
                border-color: var(--primary-dark);
                box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            }

        .staff-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color), #1d4ed8);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
            border: 3px solid white;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            position: relative;
        }

        .staff-item.active .staff-avatar {
            border-color: white;
        }

        .staff-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }

        .staff-status {
            position: absolute;
            bottom: 0;
            right: 0;
            width: 14px;
            height: 14px;
            background: var(--online-color);
            border: 2px solid white;
            border-radius: 50%;
        }

        .staff-name {
            font-size: 0.75rem;
            font-weight: 600;
            text-align: center;
            color: var(--text-dark);
            line-height: 1.3;
        }

        .staff-item.active .staff-name {
            color: white;
        }

        .staff-role {
            font-size: 0.625rem;
            color: var(--text-muted);
            text-align: center;
            margin-top: 0.125rem;
        }

        .staff-item.active .staff-role {
            color: rgba(255, 255, 255, 0.8);
        }

        /* Message Container */
        .message-container {
            flex: 1 !important;
            display: flex !important;
            flex-direction: column !important;
            background: white !important;
        }

        #messageContainer {
            flex: 1 !important;
            padding: 1.25rem !important;
            overflow-y: auto !important;
            background: linear-gradient(135deg, #f8fafc, white) !important;
        }

        /* Message Bubbles */
        .message-bubble {
            margin-bottom: 1rem;
            animation: fadeIn 0.3s ease;
        }


        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .message-sent {
            display: flex;
            justify-content: flex-end;
        }

        .message-received {
            display: flex;
            justify-content: flex-start;
        }

        .message-content {
            max-width: 75%;
            padding: 0.875rem 1.125rem;
            border-radius: 1.125rem;
            font-size: 0.9375rem;
            line-height: 1.5;
            word-wrap: break-word;
        }

        .message-sent .message-content {
            background: linear-gradient(135deg, var(--primary-color), #1d4ed8);
            color: white;
            border-bottom-right-radius: 0.25rem;
            box-shadow: 0 2px 8px rgba(59, 130, 246, 0.2);
        }

        .message-received .message-content {
            background: white;
            color: var(--text-dark);
            border: 2px solid var(--border-color);
            border-bottom-left-radius: 0.25rem;
        }

        .message-sender {
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 0.375rem;
            color: var(--text-muted);
        }

        .message-time {
            font-size: 0.6875rem;
            color: var(--text-muted);
            margin-top: 0.375rem;
            text-align: right;
        }

        .message-sent .message-time {
            color: rgba(255, 255, 255, 0.8);
        }

        /* Chat Footer */
        .chat-footer {
            padding: 1.25rem !important;
            background: white !important;
            border-top: 2px solid var(--border-color) !important;
        }

        #messageInput {
            border: 2px solid var(--border-color) !important;
            border-radius: 2rem 0 0 2rem !important;
            padding: 0.875rem 1.25rem !important;
            font-size: 0.9375rem !important;
            transition: all 0.2s ease;
        }

            #messageInput:focus {
                outline: none !important;
                border-color: var(--primary-color) !important;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1) !important;
            }

        #sendMsgBtn {
            background: linear-gradient(135deg, var(--success-color), #059669) !important;
            border: none !important;
            border-radius: 0 2rem 2rem 0 !important;
            padding: 0.875rem 1.5rem !important;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            #sendMsgBtn:hover {
                transform: scale(1.05);
                box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
            }

            #sendMsgBtn i {
                font-size: 1.125rem;
            }

        /* Scrollbar */
        .staff-list-container::-webkit-scrollbar,
        #messageContainer::-webkit-scrollbar {
            width: 6px;
        }

        .staff-list-container::-webkit-scrollbar-track,
        #messageContainer::-webkit-scrollbar-track {
            background: var(--bg-light);
        }

        .staff-list-container::-webkit-scrollbar-thumb,
        #messageContainer::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 10px;
        }

        /* Empty State */
        .empty-chat-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100%;
            color: var(--text-muted);
            padding: 2rem;
            text-align: center;
        }

            .empty-chat-state i {
                font-size: 3rem;
                margin-bottom: 1rem;
                opacity: 0.5;
            }

            .empty-chat-state p {
                font-size: 0.9375rem;
                line-height: 1.6;
            }

        /* Responsive */

    </style>


    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Chat functionality
        $(document).ready(function() {
            let selectedStaffId = "";
            let selectedStaffName = "";

            // Open/Close chat
            $("#openChatBtn").click(function() {
                $("#userChatBox").fadeIn(300);
            });

            $("#closeChatBtn").click(function() {
                $("#userChatBox").fadeOut(300);
            });

            // Select staff
            $(".staff-item").click(function() {
                $(".staff-item").removeClass("active");
                $(this).addClass("active");

                selectedStaffId = $(this).data("staff-id");
                selectedStaffName = $(this).find(".staff-name").text();

                // Clear and show chat
                $("#messageContainer").html(`
                    <div style="text-align: center; padding: 1rem; color: var(--text-muted);">
                        <i class="fas fa-comments" style="font-size: 2rem; margin-bottom: 0.5rem;"></i>
                        <p style="margin: 0; font-size: 0.875rem;">Bắt đầu trò chuyện với <strong>${selectedStaffName}</strong></p>
                    </div>
                `);
            });

            // Send message
            $("#sendMsgBtn").click(function() {
                sendMessage();
            });

            $("#messageInput").keypress(function(e) {
                if(e.which == 13) {
                    sendMessage();
                }
            });

            function sendMessage() {
                const msg = $("#messageInput").val().trim();
                if (msg && selectedStaffId) {
                    const time = new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });

                    appendMessage("sent", "Bạn", msg, time);
                    $("#messageInput").val("");

                    // Here you would send the message via SignalR or API
                    // connection.invoke("SendMessage", selectedStaffId, msg);
                } else if (!selectedStaffId) {
                    alert("Vui lòng chọn nhân viên để chat!");
                }
            }

            function appendMessage(type, sender, message, time) {
                if ($("#messageContainer .empty-chat-state").length) {
                    $("#messageContainer").empty();
                }

                const messageHtml = `
                    <div class="message-bubble message-${type}">
                        <div>
                            ${type === 'received' ? `<div class="message-sender">${sender}</div>` : ''}
                            <div class="message-content">
                                ${message}
                                <div class="message-time">${time}</div>
                            </div>
                        </div>
                    </div>
                `;

                $("#messageContainer").append(messageHtml);
                $("#messageContainer").scrollTop($("#messageContainer")[0].scrollHeight);
            }

            // Example: Receive message (integrate with SignalR)
            // connection.on("ReceiveMessage", function (fromId, message, time) {
            //     if (fromId === selectedStaffId) {
            //         appendMessage("received", selectedStaffName, message, time);
            //     }
            // });
        });
    </script>
}