@model WebApplication1.ViewModels.forgotPasswordVM
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<style>
    :root {
        --primary-color: #007bff; /* Màu xanh dương chủ đạo */
        --primary-hover: #0056b3;
        --success-color: #10b981;
        --border-color: #e0e0e0;
        --bg-light: #f8f9fa;
        --text-dark: #212529;
        --text-muted: #6c757d;
        --shadow-lg: 0 1rem 3rem rgba(0, 0, 0, 0.175);
    }

    /* 1. Nền trang và Container chính */
    .forgot-password-wrapper {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem; /* Tăng padding */
        min-height: 70vh; /* Chiều cao tối thiểu */
    }

    /* 2. Thẻ (Card) chính */
    .forgot-password-card {
        background: #ffffff;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-lg);
        padding: 3rem;
        max-width: 500px; /* Độ rộng tối đa cho form đơn */
        width: 100%;
        text-align: center; /* Căn giữa nội dung trong card */
        transition: all 0.3s ease;
        transform: translateY(0); /* Trạng thái ban đầu */
        opacity: 1;
        animation: fadeIn 0.5s ease-out;
    }

        .forgot-password-card:hover {
            transform: translateY(-5px); /* Hiệu ứng nhấc lên khi hover */
            box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, 0.2);
        }

    /* Hiệu ứng Fade In */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* 3. Nội dung bên trong Card */
    .card-icon {
        font-size: 3.5rem;
        color: var(--primary-color);
        margin-bottom: 1rem;
    }

    .card-title {
        font-weight: 700;
        color: var(--text-dark);
        font-size: 2rem;
        margin-bottom: 0.75rem;
    }

    .card-description {
        font-size: 1rem;
        color: var(--text-muted);
        margin-bottom: 2rem;
    }

    /* 4. Form */
    .form-group {
        margin-bottom: 1.5rem;
        text-align: left; /* Căn trái label và input */
    }

        .form-group label {
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
            display: block;
        }

    .form-control {
        display: block;
        width: 100%;
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border: 2px solid var(--border-color);
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(0,123,255,0.15);
            outline: none;
        }

    .text-danger {
        font-size: 0.875rem;
        font-weight: 500;
    }

    /* 5. Nút Submit */
    .btn-submit {
        width: 100%;
        padding: 0.875rem;
        background: var(--primary-color);
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            background: var(--primary-hover);
            transform: translateY(-3px);
            box-shadow: 0 4px 10px rgba(0,123,255,0.3);
        }

    /* 6. Link Quay lại */
    .back-to-login {
        margin-top: 2rem;
        font-size: 0.9375rem;
    }

        .back-to-login a {
            color: var(--primary-color);
            font-weight: 600;
            text-decoration: none;
        }

            .back-to-login a:hover {
                text-decoration: underline;
            }

    /* 7. Thông báo (ViewBag.Message) */
    .form-message {
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
        text-align: left;
    }

        .form-message.success {
            background: #dcfce7; /* Light green */
            color: #15803d; /* Dark green */
            border: 1px solid #bbf7d0;
        }

</style>

<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Quên mật khẩu</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Home</a></li>
        <li class="breadcrumb-item"><a href="#">Pages</a></li>
        <li class="breadcrumb-item active text-white">Quên mật khẩu</li>
    </ol>
</div>
<div class="forgot-password-wrapper">
    <div class="forgot-password-card">
        <div class="card-icon">🔑</div>
        <h3 class="card-title">Quên mật khẩu?</h3>
        <p class="card-description">
            Đừng lo lắng! Chỉ cần nhập email của bạn dưới đây và chúng tôi sẽ gửi cho bạn một liên kết để đặt lại mật khẩu.
        </p>

        @if (ViewBag.Message != null)
        {
            <div class="form-message success">
                @ViewBag.Message
            </div>
        }

        <form asp-action="forgotPassword" asp-controller="KhachHang">
            <div class="form-group">
                <label asp-for="@Model.Email">Email của bạn <sup>*</sup></label>
                <input asp-for="@Model.Email" type="email" class="form-control" placeholder="Nhập email của bạn...">
                <span class="text-danger" asp-validation-for="@Model.Email"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Gửi liên kết đặt lại" class="btn-submit" />
            </div>
        </form>

        <div class="back-to-login">
            <a asp-action="DangNhap" asp-controller="KhachHang">
                ← Quay lại trang Đăng nhập
            </a>
        </div>
    </div>
</div>