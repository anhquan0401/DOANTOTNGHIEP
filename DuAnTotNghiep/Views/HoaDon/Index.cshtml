@model IEnumerable<WebApplication1.ViewModels.LichSuHoaDonVM>

@{
    ViewData["Title"] = "Tất cả đơn mua";
    // var currentTab = ViewBag.CurrentTab as string ?? "Index";
    // var count = ViewBag.Count as int? ?? 0;
   
    // var NewOrderCount = ViewBag.NewOrderCount as int? ?? 0;
    // var PendingShipmentCount = ViewBag.PendingShipmentCount as int? ?? 0;
    // var PaidCount = ViewBag.PaidCount as int? ?? 0;
    // var LichSuHoaDonCount = ViewBag.LichSuHoaDonCount as int? ?? 0;
    // var CancelledCount = ViewBag.CancelledCount as int? ?? 0;
}

<!-- Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Tất cả đơn mua</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Home</a></li>
        <li class="breadcrumb-item"><a href="#">Pages</a></li>
        <li class="breadcrumb-item active text-white">Tất cả đơn mua</li>
    </ol>
</div>

<!-- Navigation Tabs -->
@await Component.InvokeAsync("HoaDon", new { currentTab = ViewBag.CurrentTab ?? "Index" })


<!-- Order List -->
<div class="container mt-5">
    @foreach (var hoaDon in Model)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Mã hóa đơn: @hoaDon.MaHd</h5>
                <a asp-action="Details" asp-route-id="@hoaDon.MaHd" class="btn btn-light btn-sm">Xem chi tiết</a>
            </div>
            <div class="card-body">
                <table class="table table-bordered text-center align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Tên hàng hóa</th>
                            <th>Hình ảnh</th>
                            <th>Số lượng</th>
                            <th>Đơn giá</th>
                            <th>Giảm giá</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var chiTiet in hoaDon.ChiTietHds)
                        {
                            <tr>
                                <td class="align-middle">@chiTiet.TenHh</td>
                                <td class="align-middle">
                                    <img src="~/Hinh/HangHoa/@chiTiet.Hinh" class="img-thumbnail" style="width: 80px; height: 80px;">
                                </td>
                                <td class="align-middle">@chiTiet.SoLuong</td>
                                <td class="align-middle">@chiTiet.DonGia.ToString("#,##").Replace(',', '.')$</td>
                                <td class="align-middle">@chiTiet.GiamGia.ToString("C")</td>
                                <td class="align-middle text-danger fw-bold">@chiTiet.ThanhTien.ToString("#,##").Replace(',', '.')$</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
