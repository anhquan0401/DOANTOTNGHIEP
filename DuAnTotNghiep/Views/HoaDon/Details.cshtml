@model WebApplication1.ViewModels.LichSuHoaDonVM

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
}

<!-- Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Chi tiết hóa đơn</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Home</a></li>
        <li class="breadcrumb-item"><a href="#">Pages</a></li>
        <li class="breadcrumb-item active text-white">Chi tiết hóa đơn</li>
    </ol>
</div>

<!-- Order Details -->
<div class="container mt-5">
    <div class="card shadow-lg p-4 position-relative">
        <!-- Back Button (Icon) -->
        <a href="javascript:history.back()" class="position-absolute top-0 start-0 m-3 text-dark">
            <i class="fas fa-arrow-left fs-3"></i>
        </a>

        <h3 class="text-center text-primary fw-bold">Đơn hàng #@Model.MaHd</h3>
        <hr>

        <div class="row">
            <div class="col-md-6">
                <h5><strong>Ngày đặt:</strong> @Model.NgayDat</h5>
                <h5><strong>Ngày giao:</strong> @Model.NgayGiao</h5>
                <h5><strong>Họ tên:</strong> @Model.HoTen</h5>
                <h5><strong>Điện thoại:</strong> @Model.DienThoai</h5>
            </div>
            <div class="col-md-6">
                <h5><strong>Địa chỉ:</strong> @Model.DiaChi</h5>
                <h5><strong>Thanh toán:</strong> @Model.CachThanhToan</h5>
                <h5><strong>Vận chuyển:</strong> @Model.CachVanChuyen</h5>
                <h5><strong>Phí vận chuyển:</strong> <span class="text-danger fw-bold">@Model.PhiVanChuyen$</span></h5>
            </div>
        </div>

        <div class="mt-3">
            <h5 class="fw-bold">Trạng thái: <span class="badge bg-success">@Model.TrangThai</span></h5>
            <h5 class="fw-bold">Cập nhật: <span class="text-muted">@Model.NgayCapNhat</span></h5>
            <h4 class="fw-bold text-danger mt-3">Tổng tiền: @Model.TongTien.ToString("#,##").Replace(',', '.')$</h4>
        </div>
    </div>
</div>

<!-- Order Items Table -->
<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0">Danh sách sản phẩm</h4>
        </div>
        <div class="card-body">
            <table class="table table-bordered text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Tên hàng hóa</th>
                        <th>Hình ảnh</th>
                        <th>Số lượng</th>
                        <th>Đơn giá</th>
                        <th>Giảm giá</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var chiTiet in Model.ChiTietHds)
                    {
                        <tr>
                            <td class="align-middle">@chiTiet.TenHh</td>
                            <td class="align-middle">
                                <img src="~/Hinh/HangHoa/@chiTiet.Hinh" class="img-thumbnail" style="width: 80px; height: 80px;">
                            </td>
                            <td class="align-middle">@chiTiet.SoLuong</td>
                            <td class="align-middle">@chiTiet.DonGia.ToString("#,##").Replace(',', '.')$</td>
                            <td class="align-middle">@chiTiet.GiamGia.ToString("C")</td>
                            <td class="align-middle text-danger fw-bold">@chiTiet.ThanhTien.ToString("#,##").Replace(',', '.')$</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
