@model List<WebApplication1.Data.Voucher>

@{
    ViewData["Title"] = "Danh sách Voucher";
    var collectedIds = ViewBag.CollectedVoucherIds as List<int> ?? new List<int>();
}

<style>
    /* 1. Biến màu sắc và Kiểu dáng chung */
    :root {
        --primary-color: #007bff;
        --primary-hover: #0056b3;
        --success-color: #10b981;
        --success-hover: #0f9b6c;
        --warning-color: #f59e0b;
        --disabled-color: #adb5bd;
        --bg-light: #f8fafc;
        --text-dark: #1e293b;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --shadow-soft: 0 4px 15px rgba(0, 0, 0, 0.07);
        --shadow-lifted: 0 10px 25px rgba(0, 0, 0, 0.1);
        /* Màu Gradient cho Voucher */
        --voucher-grad: linear-gradient(135deg, var(--primary-color), var(--primary-hover));
        --voucher-grad-expired: linear-gradient(135deg, #6c757d, #495057);
    }

    /* 2. Nền trang và Header */
    .voucher-page-container {
        background-color: var(--bg-light);
        padding-top: 3rem;
        padding-bottom: 3rem;
    }

    .voucher-page-header {
        text-align: center;
        margin-bottom: 3rem;
        animation: fadeInDown 0.8s ease-out;
    }

        .voucher-page-header h2 {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--text-dark);
        }

        .voucher-page-header p {
            font-size: 1.125rem;
            color: var(--text-muted);
        }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* 3. Thẻ Voucher */
    .voucher-card {
        display: flex; /* Bố cục flex: stub (trái) và info (phải) */
        border-radius: 0.75rem;
        background: #ffffff;
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-soft);
        overflow: hidden; /* Quan trọng để bo góc */
        position: relative; /* Quan trọng cho hiệu ứng "xé" */
        transition: all 0.3s ease-out;
        animation: fadeInUp 0.8s ease-out;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* 4. Hiệu ứng "Nâng lên" khi Hover */
    .voucher-card:not(.expired):hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lifted);
    }

    /* 5. Trạng thái Hết Hạn */
    .voucher-card.expired {
        opacity: 0.65;
    }

    /* 6. Cuống Vé (Bên trái) */
    .voucher-stub {
        flex: 0 0 120px; /* Cố định chiều rộng 120px */
        background: var(--voucher-grad);
        color: white;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        text-align: center;
        border-right: 2px dashed rgba(255, 255, 255, 0.4); /* Đường đứt nét */
    }

    .voucher-card.expired .voucher-stub {
        background: var(--voucher-grad-expired); /* Màu xám khi hết hạn */
    }

    .stub-icon {
        font-size: 2rem;
        opacity: 0.8;
        margin-bottom: 0.5rem;
    }

    .stub-discount {
        font-size: 1.75rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .stub-type {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        opacity: 0.9;
    }

    /* 7. Hiệu ứng "Xé" (Hole punch) */
    .voucher-card::before, .voucher-card::after {
        content: '';
        position: absolute;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--bg-light); /* Phải trùng màu nền của trang */
        left: 110px; /* 120px (width stub) - 10px (nửa width) */
        z-index: 10;
    }

    .voucher-card::before {
        top: -10px; /* Nửa trên */
    }

    .voucher-card::after {
        bottom: -10px; /* Nửa dưới */
    }

    /* 8. Thông tin Voucher (Bên phải) */
    .voucher-info {
        flex: 1; /* Chiếm phần còn lại */
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .info-header h5 {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--text-dark);
        margin-top: 0.5rem;
        margin-bottom: 0;
        /* Chống tràn text nếu tên quá dài */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        min-height: 33px; /* Giữ chiều cao cho 2 dòng */
    }

    /* 9. Danh sách Điều kiện */
    .info-conditions {
        list-style: none;
        padding: 0;
        margin: 1rem 0;
        font-size: 0.875rem;
        color: var(--text-muted);
    }

        .info-conditions li {
            display: flex;
            align-items: center;
            gap: 8px; /* Khoảng cách giữa icon và text */
            margin-bottom: 0.5rem;
        }

            .info-conditions li i {
                color: var(--primary-color);
                width: 16px;
                text-align: center;
            }

            .info-conditions li.expires i {
                color: var(--danger-color);
            }


    /* 10. Khu vực Nút Bấm */
    .info-action {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--border-color);
        padding-top: 1rem;
        margin-top: auto; /* Luôn đẩy xuống dưới cùng */
    }

    .btn-conditions {
        font-size: 0.875rem;
        color: var(--text-muted);
        text-decoration: none;
        font-weight: 600;
    }

        .btn-conditions:hover {
            color: var(--primary-color);
            text-decoration: underline;
        }

    .btn-get {
        background: var(--success-color);
        color: white;
        border: none;
        padding: 0.5rem 1.25rem;
        font-size: 0.875rem;
        font-weight: 700;
        border-radius: 2rem; /* Bo tròn */
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .btn-get:not(.disabled):hover {
            background: var(--success-hover);
            transform: scale(1.05);
            box-shadow: 0 4px 10px rgba(16, 185, 129, 0.3);
        }

        .btn-get.disabled {
            background: var(--disabled-color);
            cursor: not-allowed;
            color: #f8f9fa;
        }

    /* 11. Responsive */
    @@media (max-width: 576px) {
        .voucher-stub {
            flex: 0 0 100px; /* Thu nhỏ cuống vé trên mobile */
        }

        .voucher-card::before, .voucher-card::after {
            left: 90px; /* 100px - 10px */
        }

        .stub-discount {
            font-size: 1.25rem;
        }

        .stub-icon {
            font-size: 1.5rem;
        }
    }
</style>

<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6">Voucher</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a href="#">Home</a></li>
        <li class="breadcrumb-item"><a href="#">Pages</a></li>
        <li class="breadcrumb-item active text-white">Danh sách Voucher</li>
    </ol>
</div>

<div class="container voucher-page-container">
    <div class="voucher-page-header">
        <h2>Kho Voucher Của Bạn</h2>
        <p>Lưu ngay những ưu đãi hấp dẫn trước khi hết hạn!</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            // Kiểm tra trạng thái voucher
            // Kiểm tra trạng thái hết hạn
            bool isExpired = !item.IsActive || item.ExpirationDate < DateTime.Now;
            // Kiểm tra đã lấy chưa
            bool isCollected = collectedIds.Contains(item.VoucherId);

            string cardClass = isExpired ? "expired" : "";


            <div class="col">
                <div class="voucher-card @cardClass h-100">

                    <div class="voucher-stub">
                        <div class="stub-icon">
                            <i class="fas fa-ticket-alt"></i>
                        </div>
                        <div class="stub-discount">
                            @item.DiscountVoucher%
                        </div>
                        <div class="stub-type">GIẢM GIÁ</div>
                    </div>

                    <div class="voucher-info">
                        <div>
                            <div class="info-header">
                                <span class="badge bg-warning text-dark">Số lượng có hạn</span>
                                <h5>@item.VoucherName</h5>
                            </div>
                            <ul class="info-conditions">
                                <li>
                                    <i class="fas fa-shopping-cart"></i>
                                    <span>Đơn tối thiểu: <strong>@(item.OrderMinimum.HasValue? item.OrderMinimum.Value.ToString("N0") + "đ" : "0đ")</strong></span>
                                </li>
                                <li class="expires">
                                    <i class="fas fa-clock"></i>
                                    <span>Hết hạn: <strong>@item.ExpirationDate.ToString("dd/MM/yyyy")</strong></span>
                                </li>
                            </ul>
                        </div>

                        <div class="info-action">
                            <a href="#" class="btn-conditions">Điều kiện</a>

                            @if (isExpired)
                            {
                                @* Trường hợp 1: Hết hạn *@
                                <button type="button" class="btn-get disabled" disabled>Hết hạn</button>
                            }
                            else if (isCollected)
                            {
                                @* Trường hợp 2: Đã lấy (Logic mới thêm vào) *@
                                <button type="button" class="btn-get disabled" style="background-color: #6c757d;" disabled>
                                    <i class="fas fa-check"></i> Đã lấy
                                </button>
                            }
                            else
                            {
                                @* Trường hợp 3: Chưa lấy -> Hiện Form *@
                                <form asp-controller="Voucher" asp-action="GetVoucher" method="post">
                                    <input type="hidden" name="VoucherId" value="@item.VoucherId" />
                                    <button type="submit" class="btn-get">Lấy</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>